    <measure number="21">
      <direction placement="below">
        <direction-type>
          <words valign="top">                   2
</words>
          <words>e
</words>
          <words> 
</words>
          <words>On admire au village, 
</words>
          <words>Son esprit sa beauté, 
</words>
          <words>Et de son doux servage 
</words>
          <words>Chacun serait flatté. 
</words>
          <words>Oui je serai fidèle 
</words>
          <words>Discret, tendre et constant, 
</words>
          <words>Plutôt mourrais loin d'elle 
</words>
          <words>Qu'oublier mon serment.
</words>
          <words>
</words>
          <words>                    3
</words>
          <words>e
</words>
          <words>
</words>
          <words>Si la belle Zélie 
</words>
          <words>Prononçait mot d'amour 
</words>
          <words>Pendant toute ma vie 
</words>
          <words>Bénirais si beau jour. 
</words>
          <words>Oui je serai fidèle, 
</words>
          <words>Discret, tendre et constant, 
</words>
          <words>Plutôt mourrais loin d'elle 
</words>
          <words>Qu'oublier mon serment.
</words>
          <words></words>
          </direction-type>
